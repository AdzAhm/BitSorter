{
  "name": "Highest wins",
  "order": 75,
  "goal": "Y1 Y0 give the number of the highest input that is 1, in binary: I3 is 11, I0 is 00. V gets 1 if any input is 1 -- when none is, Y1 Y0 don't matter.",
  "hint": "a lower line only counts while every line above it is quiet.",
  "tickLimit": 60,
  "maxWireDelay": 3,
  "delayBudget": 3,
  "fixtures": [
    { "id": "i3", "kind": "Source", "cell": { "x": -4, "y":  2 }, "stream": "0000000011111111" },
    { "id": "i2", "kind": "Source", "cell": { "x": -4, "y":  1 }, "stream": "0000111100001111" },
    { "id": "i1", "kind": "Source", "cell": { "x": -4, "y": -1 }, "stream": "0011001100110011" },
    { "id": "i0", "kind": "Source", "cell": { "x": -4, "y": -2 }, "stream": "0101010101010101" },
    { "id": "y1", "kind": "Sink",   "cell": { "x":  4, "y":  2 } },
    { "id": "y0", "kind": "Sink",   "cell": { "x":  4, "y":  0 } },
    { "id": "v",  "kind": "Sink",   "cell": { "x":  4, "y": -2 } }
  ],
  "budget": [
    { "kind": "Or",  "count": 4 },
    { "kind": "Not", "count": 1 },
    { "kind": "And", "count": 1 }
  ],
  "expected": [
    { "sink": "y1", "values": "x000111111111111" },
    { "sink": "y0", "values": "x011000011111111" },
    { "sink": "v",  "values": "0111111111111111" }
  ]
}
