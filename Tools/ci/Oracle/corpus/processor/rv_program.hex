ffc3af03  // 058: lw t5, -4(t2)
01ee8fb3  // 05c: add t6, t4, t5            needs the load just before it
01f3a023  // 060: sw t6, 0(t2)
00438393  // 064: addi t2, t2, 4
ffc3e6e3  // 068: bltu t2, t3, fib_loop
00008067  // 06c: jalr zero, 0(ra)          return
