<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The tests of BitSorter 5.0's document layer: the model and its nets, the rules an edit is held to,
    the editor and its undo, and the compiler and printer, whose output is run by the engine and
    read back by the reader. The Oracle project runs printed boards under Icarus.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>BitSorter.Board.Tests</AssemblyName>
    <RootNamespace>BitSorter.Board.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Board/Board.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Shared/RepoRoot.cs" Link="Shared/RepoRoot.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
  </ItemGroup>

</Project>
