<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The tests of BitSorter 5.0's view-model: a run read at a moment, the schematic's routes and
    layout, pan and zoom, and the chunking: all of it Unity-free, so it runs here in seconds. What
    needs uGUI (the colours drawn, the meshes) stays in Edit Mode.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>BitSorter.ViewModel.Tests</AssemblyName>
    <RootNamespace>BitSorter.ViewModel.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../ViewModel/ViewModel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The boards the oracle runs (Part 14c): the step tests measured here are the runs Icarus is held to. -->
    <Compile Include="../Board.Tests/SampleBoards.cs" Link="Shared/SampleBoards.cs" />
    <!-- The exercises as the game ships them (Part 15d): the run the EXERCISES page lists. -->
    <Compile Include="../Board.Tests/ExerciseFiles.cs" Link="Shared/ExerciseFiles.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
  </ItemGroup>

</Project>
