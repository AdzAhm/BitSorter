<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The tests of BitSorter 5.0's engine: hand-computed waveforms (the probe circuits Icarus confirmed),
    wire resolution and the primitives, inertial delay, determinism under shuffled construction,
    run control, VCD, a zero-delay loop that must stop rather than hang, the zero-allocation
    guardrail and a throughput floor. Probes.cs is shared with the Oracle project, which runs the
    same circuits under Icarus.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>BitSorter.Sim.Tests</AssemblyName>
    <RootNamespace>BitSorter.Sim.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Sim/Sim.csproj" />
  </ItemGroup>

  <!-- The elaborator's tests read the oracle corpus, which RepoRoot finds from wherever the tests run. -->
  <ItemGroup>
    <Compile Include="../Shared/RepoRoot.cs" Link="Shared/RepoRoot.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
  </ItemGroup>

</Project>
