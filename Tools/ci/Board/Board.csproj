<Project Sdk="Microsoft.NET.Sdk">

  <!--
    BitSorter 5.0's document layer, built without Unity: netstandard2.1 and C# 9, as Unity builds it.
    It references the SystemVerilog and engine layers, and nothing references it but the view.
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>BitSorter.Board</AssemblyName>
    <RootNamespace>BitSorter.Board</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../../Assets/Scripts/Board/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SystemVerilog/SystemVerilog.csproj" />
    <ProjectReference Include="../Sim/Sim.csproj" />
  </ItemGroup>

</Project>
