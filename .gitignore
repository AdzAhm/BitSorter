# ---------------------------------------------------------------------
# Unity generated folders
# ---------------------------------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated by Unity's package manager / asset store tools
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/Plugins/Editor/JetBrains*

# ---------------------------------------------------------------------
# IDE / editor files
# ---------------------------------------------------------------------
.vs/
.vscode/
.idea/
.gradle/
ExportedObj/
*.userprefs
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ---------------------------------------------------------------------
# Generated C# project and solution files (Unity regenerates these)
# ---------------------------------------------------------------------
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ---------------------------------------------------------------------
# Build results / native artifacts
# ---------------------------------------------------------------------
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties

# Builds produced by the Unity Addressables / Burst systems
/[Ss]erver[Bb]uild/
sysinfo.txt

# ---------------------------------------------------------------------
# OS files
# ---------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------
# Play Mode test run leftovers
# ---------------------------------------------------------------------
# The test framework builds a temporary scene and a run manifest inside Assets/
# and removes them in its post-build cleanup. A run that is interrupted -- or one
# where the editor loses focus and stops ticking -- leaves them behind, where they
# show up as untracked files that look like something went wrong.
#
# These rules come after the "!/[Aa]ssets/**/*.meta" negation above on purpose:
# later rules win, so the companion .meta files are ignored too.
#
# The run manifests land in Assets/Resources/, not in Assets/ -- the performance
# testing package needs them loadable at runtime. There are two of them, Info and
# Settings, and only one was named here. Both were left behind by an interrupted
# run and both showed up as untracked; neither matched these rules.
/[Aa]ssets/InitTestScene*.unity
/[Aa]ssets/InitTestScene*.unity.meta
/[Aa]ssets/[Rr]esources/PerformanceTestRun*.json
/[Aa]ssets/[Rr]esources/PerformanceTestRun*.json.meta
/[Pp]roject[Ss]ettings/PerformanceTestSettings.json
